[Unit]
Description=clutch, the keys that are yours before any program's

[Service]
Type=notify
ExecStart=@EXE@ run
Restart=on-failure
RestartSec=1
# A clutch that stops answering is killed, which gives the keyboards back.
WatchdogSec=5
# What the keys start outlives a restart of clutch.
KillMode=process
OOMPolicy=continue

[Install]
WantedBy=default.target
